{
  "name": "wavespeed-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official self-hostable Discord bot for WaveSpeed — generate images and video from slash commands.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaveSpeedAI/wavespeed-discord-bot.git"
  },
  "homepage": "https://wavespeed.ai",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "wavespeed": "^0.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.11"
  }
}
